{
  "name": "lms",
  "version": "1.0.0",
  "description": "Minimal Korean LMS on Cloudflare Workers + D1",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/auth.mjs && node --check public/app.js && node --check src/worker.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply lms --local",
    "db:migrate": "wrangler d1 migrations apply lms --remote",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "private": true,
  "devDependencies": {
    "wrangler": "^4.161.0"
  }
}
